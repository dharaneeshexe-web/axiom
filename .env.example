# Razorpay keys (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Groq API keys (comma-separated for rotation)
GROQ_API_KEYS=gsk_key1,gsk_key2

# Laminar
LMNR_PROJECT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LAMINAR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LAMINAR_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Database
DATABASE_URL=sqlite:///./payments.db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Agent
MAX_RETRIES=3
PAYMENT_TIMEOUT=30
MAX_LLM_ITERATIONS=10

# Demo failure scenario (none | card_declined | insufficient_funds | expired_card | processing_error | invalid_vpa)
DEMO_FAILURE=none
